# ECNS Contracts Environment Configuration

# Deployer private key (without 0x prefix)
DEPLOYER_KEY=
OWNER_KEY=

# Ethereum Classic RPC URLs
ETC_RPC_URL=https://etc.rivet.cloud
MORDOR_RPC_URL=https://rpc.mordor.etccooperative.org

# Blockscout API key for contract verification (optional)
BLOCKSCOUT_API_KEY=

# Contract addresses (populated after deployment)
METADATA_ADDRESS=
WRAPPER_ADDRESS=
RESOLVER_ADDRESS=
